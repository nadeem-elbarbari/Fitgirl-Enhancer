{
  "manifest_version": 3,
  "name": "FitGirl Adult Filter",
  "version": "1.0.3",
  "description": "Hide or blur Adult repacks on fitgirl-repacks.site.",
  "permissions": ["storage"],
  "host_permissions": ["https://fitgirl-repacks.site/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-on-16.png",
    "48": "icons/icon-on-48.png",
    "128": "icons/icon-on-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FG Bleacher",
    "default_icon": {
      "16": "icons/icon-on-16.png",
      "32": "icons/icon-on-32.png",
      "48": "icons/icon-on-48.png",
      "128": "icons/icon-on-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://fitgirl-repacks.site/*"],
      "js": ["content/content-script.js"],
      "css": ["content/filter.css"],
      "run_at": "document_start"
    }
  ]
}
